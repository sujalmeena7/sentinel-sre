# ═══════════════════════════════════════════════════════════════
# Sentinel-SRE Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.

# ─── Required in Production ──────────────────────────────────
JWT_SECRET=                          # Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ADMIN_EMAIL=admin@yourdomain.com     # Must be a real, public TLD — `.local` is rejected by email validation
ADMIN_PASSWORD=                      # Strong password (min 8 chars, upper+lower+digit)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Browser origins allowed by CORS ────────────────────────
# Comma-separated. Added to the built-in defaults (localhost:3000/5173 and
# the deployed Vercel app). Set this when the frontend runs on another host.
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ─── LLM API providers (at least one required for analysis) ─────
# The chain is tried in this order: gateway -> Groq -> OpenAI. All three speak
# the same OpenAI /chat/completions protocol, so a provider is just a key, a
# base URL and a model id.

# Any OpenAI-compatible gateway (quota marketplaces, OpenRouter, LiteLLM, a
# self-hosted proxy). Tried FIRST when all three of these are set — the point is
# to spend gateway credit instead of an exhausted direct key. Skipped entirely
# if any one is missing; there is no default model id, because a gateway's
# catalogue is its own and a guessed id 404s in a way that looks like an outage.
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_BASE_URL=            # e.g. https://your-gateway.example.com/v1 — include the /v1
LLM_GATEWAY_MODEL=               # exact id from the gateway's own model list
# Comma-separated next choices. A quota-sharing gateway pools upstream keys, so
# one model can be supply-exhausted while others answer fine — prefer different
# model families here, since one upstream pool drains at a time and a
# same-family fallback tends to be down in the same moment.
LLM_GATEWAY_FALLBACK_MODELS=
# Only set this if the gateway actually serves /v1/embeddings. Most proxy chat
# only, and a wrong value here fails on every indexed incident rather than once.
# Left empty, embeddings use OpenAI or the local hashing fallback.
LLM_GATEWAY_EMBED_MODEL=

# Direct provider keys, used as fallbacks behind the gateway.
GROQ_API_KEY=
OPENAI_API_KEY=
# Groq retires model ids periodically; override if the default 404s.
# Check availability: curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4o-mini

# Per-attempt HTTP timeout, and the ceiling for a whole fallback chain. Both are
# measured, not guessed: a real narrative on a pooled gateway takes a ~40s median
# and up to ~56s, so the old 20s default cut off most healthy calls. The 150s
# budget stays under gunicorn's 180s request timeout so a total failure still
# degrades to the data-only postmortem instead of a 502. Postmortem generation
# makes two chained calls and automatically uses half the budget per leg.
LLM_TIMEOUT_SECONDS=90
LLM_TOTAL_BUDGET_SECONDS=150

# ─── Optional: Vector store ─────────────────────────────────
# Where ChromaDB persists embeddings. Point this at a mounted disk in
# production; the default is relative to the backend working directory.
# Embeddings resolve in order: gateway (only when LLM_GATEWAY_EMBED_MODEL is set),
# OpenAI, then a local hashing embedding (lexical, no quota, always available).
CHROMA_PATH=./chroma_db
RAG_INDEX_BACKFILL=1                 # Set to 0 to skip re-indexing on startup

# ─── Optional: Webhook Integrations ─────────────────────────
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
TEAMS_WEBHOOK_URL=
SLACK_ALLOWED_HOSTS=*.slack.com,hooks.slack.com
TEAMS_ALLOWED_HOSTS=*.webhook.office.com,*.logic.azure.com

# ─── Optional: Email Delivery ───────────────────────────────
FRONTEND_URL=https://your-frontend-domain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Or use AWS SES:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ─── Optional: Tuning ───────────────────────────────────────
ACCESS_TOKEN_TTL_MIN=1440            # JWT lifetime (default 24h)
VERIFY_EMAIL_TTL_MIN=1440            # Email verification link lifetime
RESET_PASSWORD_TTL_MIN=60            # Password reset link lifetime
APP_ENV=production                   # Set to "production" to enforce security checks
# Email verification is enforced only when SMTP/SES is configured above.
# Set this to "true" to keep the gate off even with a mail provider present.
ALLOW_UNVERIFIED_LOGIN=false

# ─── Optional: Diagnostics ──────────────────────────────────
# Unlocks GET /api/v1/diagnostics, which reports startup results, database
# reachability and which provider keys are present (never their values). Without
# a token the endpoint 404s in production. Set this — it is the only way to see
# why a deploy is unhealthy when the database is down and nobody can log in.
DIAGNOSTICS_TOKEN=

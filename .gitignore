# Backend
backend/.env
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/incidents.db
backend/chroma_db/
backend/.pytest_cache/

# Python bytecode anywhere (the rules above only match the top backend dir,
# so backend/tests/__pycache__/ was showing up as untracked).
__pycache__/
*.py[cod]

# Frontend
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/dist/
frontend/build/
# Incremental tsc build cache — machine-local, regenerated on every typecheck.
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# General
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.png
*.jpg
*.jpeg
*.svg
!frontend/public/*.svg
!frontend/public/*.png

# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# Kiro settings (contains tokens)
.kiro/settings/mcp.json
